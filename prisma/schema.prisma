generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Habit {
  id            String   @id @default(cuid())
  label         String
  streak        Int      @default(0)
  lastChecked   String?
  markedForDate String?
  createdAt     DateTime @default(now())
}